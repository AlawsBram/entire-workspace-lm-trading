# ============================================================
# HYPERLIQUID TRIMMER — config template
# Copy to .env and fill in YOURSELF. Then: chmod 600 .env
# NEVER paste private keys into chat or logs.
# ============================================================

# --- READ-ONLY (no keys needed — Hyperliquid positions are public) ---
# The wallet address whose position to protect. Can be YOURS or any
# public address for observation/dry-run practice.
HL_WALLET_ADDRESS=

# Which coin to watch: "BTC", "ETH", ... or "auto" = biggest position
COIN=auto

# --- STRATEGY PARAMETERS (values from the stream's final config) ---
TRIGGER_PERCENT=2.0        # start trimming within 2% of liquidation price
TRIM_PERCENT=5.0           # each trim closes 5% of the CURRENT position
SLIPPAGE_PERCENT=2.0       # IOC limit cap — rather lose a little slippage
LOOP_SECONDS=1.0           # check every 1 second
TRIM_WAIT_SECONDS=2.0      # after a trim, wait 2s then re-check
MAX_TRIMS=0                # 0 = unlimited (production). >0 = TESTING ONLY.

# --- LIVE TRADING (leave false until the test ladder in instructions.md) ---
LIVE=false
HL_PRIVATE_KEY=
# Testnet drill: HL_API=https://api.hyperliquid-testnet.xyz
HL_API=https://api.hyperliquid.xyz

# --- OPTIONAL throttle backup (Moon Dev API, if you have a key) ---
MOONDEV_API_URL=
MOONDEV_API_KEY=

# --- KILL SWITCH: `touch KILL` next to the script = instant standby ---
